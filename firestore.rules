rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ganpati_public_status_a/{document} { allow read: if true; allow create, update: if request.auth != null || request.resource.data.received == true; }
    match /ganpati_public_status_b/{document} { allow read: if true; allow create, update: if request.auth != null || request.resource.data.received == true; }
    match /ganpati_collection_a/{document} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth != null || (request.resource.data.type == 'incoming' && request.resource.data.wing == 'A' && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.ownerId is string);
    }
    match /ganpati_collection_b/{document} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth != null || (request.resource.data.type == 'incoming' && request.resource.data.wing == 'B' && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.ownerId is string);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
